{
  "cli": { "appVersionSource": "local" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "APP_VARIANT": "development" }
    },
    "simulator": {
      "extends": "development",
      "ios": { "simulator": true }
    },
    "staging": {
      "distribution": "internal",
      "env": { "APP_VARIANT": "staging" }
    },
    "production": {
      "env": { "APP_VARIANT": "production" }
    }
  }
}
